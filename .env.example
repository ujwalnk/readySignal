# Copy to .env (chmod 600). Generate a strong value:  openssl rand -base64 36
# NEVER commit the real file. Losing this value makes the encrypted data unrecoverable.
SECRET=
# Host directory bind-mounted at /data (default ./data). Must be owned by UID/GID 10001, mode 700.
# DATA_HOST_DIR=./data
# Public address of this app (used only to print the widget iframe snippet).
# PUBLIC_BASE_URL=https://signal.example.ts.net
# Reverse-proxy address(es) whose X-Forwarded-* headers are trusted (default 127.0.0.1).
# FORWARDED_ALLOW_IPS=127.0.0.1
